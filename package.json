{
  "name": "fitness-app",
  "version": "0.1.0",
  "description": "A GPS running and cardio tracker that keeps every run on your own device",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:core && npm run test:keys",
    "icons": "node tools/make-icons.mjs",
    "test:browser": "node tests/browser.test.mjs",
    "test:i18n": "node tests/i18n.test.mjs",
    "test:core": "esbuild tests/core.test.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/core.test.bundle.mjs --log-level=error && node node_modules/.cache/core.test.bundle.mjs",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:studio": "npm run build && npm run android:sync && npx cap open android",
    "android:run": "npm run build && npx cap run android",
    "test:keys": "node tests/keys.test.mjs"
  },
  "license": "ISC",
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.2.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-health": "^8.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.0",
    "playwright": "^1.56.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
